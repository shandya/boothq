DATABASE_URL=postgresql://boothq:boothq@localhost:5432/boothq_test?connection_limit=20&pool_timeout=20
DIRECT_URL=postgresql://boothq:boothq@localhost:5432/boothq_test
JWT_SECRET=test-secret-do-not-use-in-production-32bytes
# ADMIN_PIN_HASH is `pnpm --filter api hash-pin 111111`, ILLUSTRATOR_PIN_HASH is `pnpm --filter api hash-pin 222222`.
# Integration tests log in with those PINs; copy this file to .env.test and fill in your own hashes.
ADMIN_PIN_HASH=
ILLUSTRATOR_PIN_HASH=
PUBLIC_WEB_URL=http://localhost:3000
DEFAULT_COUNTRY=ID
PORT=4000
