{
  "name": "@boothq/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./enums": { "types": "./dist/enums.d.ts", "default": "./dist/enums.js" },
    "./schemas": { "types": "./dist/schemas.d.ts", "default": "./dist/schemas.js" },
    "./dto": { "types": "./dist/dto.d.ts", "default": "./dist/dto.js" },
    "./eta": { "types": "./dist/eta.d.ts", "default": "./dist/eta.js" },
    "./format": { "types": "./dist/format.d.ts", "default": "./dist/format.js" },
    "./messages": { "types": "./dist/messages.d.ts", "default": "./dist/messages.js" }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  }
}
